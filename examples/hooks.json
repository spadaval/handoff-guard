{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*(spawn_agent|send_message|send_input|followup_task|delegate_task|t3_thread_send|t3_thread_launch)$",
        "hooks": [
          {
            "type": "command",
            "command": "/root/.local/bin/handoff-guard hook",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
